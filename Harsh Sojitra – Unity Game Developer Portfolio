<style>
:root{--bg:#fbf6ee;--surface:#fff;--ink:#231d12;--muted:#6b6254;--line:#e6dcc8;--gold:#b8791a;--goldsoft:#f4e3bd;--btn:#231d12;--btnink:#fbf6ee;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#15130f;--surface:#1f1c16;--ink:#f6efe0;--muted:#a79d8b;--line:#332f26;--gold:#e5a93a;--goldsoft:#3a2d12;--btn:#e5a93a;--btnink:#15130f}}
:root[data-theme="dark"]{--bg:#15130f;--surface:#1f1c16;--ink:#f6efe0;--muted:#a79d8b;--line:#332f26;--gold:#e5a93a;--goldsoft:#3a2d12;--btn:#e5a93a;--btnink:#15130f}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.6 "DM Sans",system-ui,sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:"Bricolage Grotesque","DM Sans",sans-serif;line-height:1.1;margin:0}
header.hero{padding:64px 0 40px;border-bottom:1px solid var(--line)}
h1{font-size:clamp(44px,9vw,92px);font-weight:800;letter-spacing:-.03em}
.role{font-size:clamp(18px,3vw,24px);color:var(--gold);font-weight:700;margin:10px 0 18px}
.lead{max-width:60ch;color:var(--muted);font-size:18px}
.stats{display:flex;flex-wrap:wrap;gap:28px;margin:30px 0 26px}
.stat b{display:block;font:800 40px/1 "Bricolage Grotesque",sans-serif;color:var(--gold)}
.stat span{font-size:14px;color:var(--muted)}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.btn{display:inline-block;padding:11px 20px;border-radius:999px;background:var(--btn);color:var(--btnink);font-weight:700;text-decoration:none;font-size:15px;border:2px solid var(--btn)}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn:focus-visible,.chip:focus-visible,a:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
section{padding:48px 0}
h2{font-size:clamp(28px,5vw,40px);font-weight:800;margin-bottom:8px}
.sub{color:var(--muted);margin:0 0 24px;max-width:60ch}
.feat{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.fcard{display:flex;gap:16px;padding:18px;background:var(--surface);border:2px solid var(--gold);border-radius:18px;text-decoration:none;color:inherit}
.fcard h3{font-size:22px}
.fcard p{margin:6px 0 10px;color:var(--muted);font-size:15px}
.fcard .go{font-weight:700;color:var(--gold);font-size:15px}
.tile{flex:none;width:72px;height:72px;border-radius:18px;display:grid;place-items:center;color:#fff;font:800 24px "Bricolage Grotesque",sans-serif;text-shadow:0 1px 2px rgba(0,0,0,.35)}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}
.chip{padding:8px 16px;border-radius:999px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:500 15px "DM Sans",sans-serif;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--btn);color:var(--btnink);border-color:var(--btn)}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
.card{display:flex;flex-direction:column;gap:12px;padding:16px;background:var(--surface);border:1px solid var(--line);border-radius:14px;text-decoration:none;color:inherit;transition:border-color .15s}
.card:hover{border-color:var(--gold)}
.card .tile{width:56px;height:56px;border-radius:14px;font-size:19px}
.card h3{font-size:17px;line-height:1.25}
.card small{color:var(--muted);font-size:13px}
.card .play{margin-top:auto;font-weight:700;font-size:14px;color:var(--gold)}
.hidden{display:none}
.two{display:grid;gap:32px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.tag{display:inline-block;margin:0 8px 8px 0;padding:6px 12px;border-radius:8px;background:var(--goldsoft);font-size:14px;font-weight:500}
.job{margin-bottom:22px}
.job h3{font-size:20px}.job em{font-style:normal;color:var(--gold);font-size:14px;font-weight:700}
.job ul{margin:8px 0 0;padding-left:20px;color:var(--muted)}
footer{padding:40px 0 56px;border-top:1px solid var(--line);color:var(--muted)}
footer a{color:var(--ink);font-weight:700}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
