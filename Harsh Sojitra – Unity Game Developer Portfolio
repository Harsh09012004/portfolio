<script>
const B="https://play.google.com/store/apps/details?id=";
const G=[
["Shotgun Sounds Gun Simulator","com.gun.simulator.sound","Simulator","Main gameplay and features, UI revamp, full monetization setup.",1],
["Math Wise: Brain Number Game","mathgames.crossword.mathpuzzles.logic.number.challenge","Puzzle","Core game logic, UI/UX, ads integration and publishing.",1],
["Chess Master – Board Game","com.minirog.chess.chessmaster","Board"],
["Nine Men's Morris: Mills Game","com.masterboardgame.mills","Board"],
["Draw One Part","com.drawline.missingonepart","Puzzle"],
["Hero Blast: Match 3 Puzzle","com.blast.adventure","Puzzle"],
["Pup Tile Journey","com.sp.dogggo","Puzzle"],
["Candy Pop Mania: Match 3 Fun","com.matchtile.match3.tilegame.puzzle","Puzzle"],
["Dot Connect Puzzle: One Line","com.dotconnect.puzzle","Puzzle"],
["Colorful Block Puzzle Game","com.colorfulblock.puzzlegame","Puzzle"],
["Hexa Block Puzzle Game","com.hexablock.colorpuzzle","Puzzle"],
["Block Puzzle – Win Master","com.blockpuzzle.win.master.real","Puzzle"],
["Ball Sort Puzzle – Color Sort","com.ball.sort.puzzle.color.bubble.sorting","Puzzle"],
["Ball Sort Mania: Color Puzzle","water.sort.puzzle.liquidsort.color.sort","Puzzle"],
["Screw Puzzle: Nuts & Bolts","com.wood.nuts.and.bolts.screw.puzzle.game","Puzzle"],
["Match 3D Master Puzzle","com.match3d.master.puzzle","Puzzle"],
["Bus Away – Clear Traffic","com.ryan.bus.away.traffic.out","Casual"],
["Bus Jam: Traffic Escape","com.minirog.busjam.trafficescape","Casual"],
["Car vs Cops: Escape Run","com.carvscops.runescape","Casual"],
["Trading Fidget Toys – 3D Pop It","com.fidgettrading.popit.game","Casual"]
];
const pal=[["#e0701f","#b8431b"],["#2f7fd1","#2a4fb0"],["#2f9e6b","#1c7a52"],["#c0449a","#8a2f8a"],["#d4a017","#b06a10"],["#5a55d6","#3b34a8"],["#d1453b","#a82a3a"]];
const ini=n=>n.replace(/[^A-Za-z0-9 ]/g,"").split(" ").filter(Boolean).slice(0,2).map(w=>w[0]).join("").toUpperCase();
const tile=(n,i)=>`<div class="tile" style="background:linear-gradient(135deg,${pal[i%7][0]},${pal[i%7][1]})" aria-hidden="true">${ini(n)}</div>`;
const esc=s=>s.replace(/&/g,"&amp;").replace(/</g,"&lt;");
document.getElementById("feat").innerHTML=G.filter(g=>g[4]).map((g,i)=>`<a class="fcard" href="${B+g[1]}" target="_blank" rel="noopener">${tile(g[0],i)}<div><h3>${esc(g[0])}</h3><p>${g[3]}</p><span class="go">Open on Google Play</span></div></a>`).join("");
const cats=["All",...new Set(G.map(g=>g[2]))];
const fl=document.getElementById("filters"),grid=document.getElementById("grid");
function render(c){
 grid.innerHTML=G.map((g,i)=>[g,i]).filter(([g])=>c==="All"||g[2]===c).map(([g,i])=>`<a class="card" href="${B+g[1]}" target="_blank" rel="noopener">${tile(g[0],i)}<div><h3>${esc(g[0])}</h3><small>${g[2]}</small></div><span class="play">Play on Google Play</span></a>`).join("");
 fl.innerHTML=cats.map(x=>`<button class="chip" aria-pressed="${x===c}" data-c="${x}">${x}${x==="All"?" ("+G.length+")":""}</button>`).join("");
}
fl.addEventListener("click",e=>{const b=e.target.closest("button");if(b)render(b.dataset.c)});
render("All");
</script>
